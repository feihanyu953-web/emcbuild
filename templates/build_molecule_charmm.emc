(* EMC: Script *)

(* CHARMM single molecule template
   Builds one isolated molecule from SMILES using CHARMM dual-field
   loading (water_ions + carb). Ultra-low density -> isolated-molecule
   box that avoids PBC self-interaction. *)

variables	= {
  seed		-> -1,
  ntotal	-> 1,
  fshape	-> 1,
  output	-> "__OUTPUT__",

  wi_parameters	-> "fields/charmm/c36a/water_ions.prm",
  wi_topology	-> "fields/charmm/c36a/water_ions.top",
  carb_parameters -> "fields/charmm/c36a/carb.prm",
  carb_topology -> "fields/charmm/c36a/carb.top",
  cg_parameters -> "fields/charmm/c36a/cgenff.prm",
  cg_topology -> "fields/charmm/c36a/cgenff.top",

  nav		-> 0.6022141179,
  temperature	-> 300,
  radius	-> 5,
  nrelax	-> 200,
  weight_nonbond -> 0.001,
  weight_bond	-> 0.001,
  weight_focus	-> 1,
  cutoff	-> 9.5,
  charge_cutoff	-> 9.5,
  kappa		-> 4,

  density1	-> 0.05,
  lprevious	-> 0,
  lphase	-> 0,

  __VARS__
};

output		= {
  debug		-> false,
  exit		-> true,
  info		-> true,
  warning	-> true
};

(* define force fields: triple loading (water_ions, then carb, then cgenff) *)

field		= { mode -> charmm, name -> {wi_parameters, wi_topology}, compress -> false };
field		= { mode -> charmm, name -> {carb_parameters, carb_topology}, compress -> false };
field		= { mode -> charmm, name -> {cg_parameters, cg_topology}, compress -> false };

(* define groups *)

groups		= { __GROUPS__ };

field		= {
  mode		-> apply,
  check		-> {atomistic -> true, charge -> true},
  debug		-> false
};

(* sizing *)

variables	= { __SIZING__ };

(* interactions *)

simulation	= {
  units		-> {permittivity -> 1, seed -> seed},
  types		-> {coulomb -> {pair -> {active -> true, cutoff -> charge_cutoff}}}
};

(* clusters *)

clusters	= {
  progress	-> none,
  __CLUSTERS__
};

field		= {
  mode		-> apply,
  check		-> {atomistic -> true, charge -> true},
  debug		-> false
};

(* build *)

types		= { charmm -> {pair -> {active -> true, mode -> repulsive}} };

variables	= {
  nphase1	-> ntotal()-ntotal,
  mphase1	-> mtotal()-mtotal,
  vphase1	-> mphase1/nav/density1,
  lbox		-> (vphase1/fshape)^(1/3),
  lphase1	-> fshape*lbox,
  lxx		-> lbox/sqrt(fshape),
  lyy		-> lbox*sqrt(fshape),
  lzz		-> lbox,
  lzy		-> 0,
  lzx		-> 0,
  lyx		-> 0,
  lphase	-> lphase1,
  ntotal	-> nphase1,
  mtotal	-> mphase1,
  vtotal	-> vphase1
};

build		= {
  system	-> {
    id		-> main,
    split	-> false,
    geometry	-> {xx -> lxx, yy -> lyy, zz -> lzz, zy -> lzy, zx -> lzx, yx -> lyx},
    temperature	-> temperature,
    flag	-> {charge -> true, geometry -> true, map -> true, pbc -> true}
  },
  select	-> {
    progress	-> list,
    frequency	-> 1,
    name	-> "error",
    order	-> random,
    cluster	-> {__CLUSTER_NAMES__},
    relax	-> {ncycles -> nrelax, radius -> radius},
    grow	-> {
      method	-> energetic,
      check	-> all,
      nbonded	-> 20,
      ntrials	-> 20,
      niterations -> 1000,
      theta	-> 0,
      weight	-> {bonded -> weight_bond, nonbonded -> weight_nonbond, focus -> weight_focus}
    }
  }
};

force		= {style -> none, message -> nkt};
force		= {style -> init, message -> nkt};

(* storage *)

put		= {name -> output, compress -> true};
pdb		= {name -> output, compress -> true, extend -> false,
		   forcefield -> charmm, detect -> false, hexadecimal -> false,
		   unwrap -> true, pbc -> true, atom -> index, residue -> index,
		   segment -> index, rank -> false, vdw -> false, cut -> false,
		   fixed -> true, rigid -> true, connectivity -> false, parameters -> false};
lammps		= {name -> output, mode -> put, forcefield -> charmm,
		   parameters -> true, types -> false, unwrap -> true,
		   charges -> true, ewald -> true};
